{
  "name": "weather-image-gen",
  "version": "1.0.0",
  "description": "Cloudflare Pages weather image generator",
  "main": "src/index.js",
  "scripts": {
    "dev": "dotenv -e .env -- wrangler pages dev . --binding IPSTACK_API_KEY=$IPSTACK_API_KEY --binding GEMINI_API_KEY=$GEMINI_API_KEY",
    "dev:worker": "dotenv -e .env -- wrangler dev --local --binding IPSTACK_API_KEY=$IPSTACK_API_KEY --binding GEMINI_API_KEY=$GEMINI_API_KEY",
    "build": "echo 'No build step needed for static site'",
    "deploy": "wrangler pages deploy . --project-name=weather-image-gen"
  },
  "dependencies": {
    "@google/genai": "^0.5.0",
    "@google/generative-ai": "^0.24.1",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "wrangler": "^3.78.0",
    "dotenv-cli": "^7.3.0"
  },
  "type": "module"
}
